#!/usr/bin/env bash
# tools/routes [--stamp]: fails when AnythingLLM no longer declares a route in default-allow.txt.
# Reads the route declarations (/app/server/endpoints) out of the pinned image (versions.env)
# and compares: nothing is started, no login. With --stamp, a pass also rewrites the "verified against"
# line of default-allow.txt to the image's version. Needs podman or docker, and Node 22.18 or later.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

engine=$(command -v podman || command -v docker) || { echo "tools/routes: needs podman or docker" >&2; exit 2; }

# Runs in the image, whose Node is old: a line "VERSION x.y.z", then "METHOD /path" for each route.
scan=$(cat <<'JS'
const fs = require("fs"), path = require("path");
const root = "/app/server/endpoints";
const files = (d) => fs.readdirSync(d, { withFileTypes: true }).flatMap((e) =>
  e.isDirectory() ? files(path.join(d, e.name)) : e.name.endsWith(".js") ? [path.join(d, e.name)] : []);
console.log("VERSION", require("/app/server/package.json").version);
for (const file of files(root)) {
  const text = fs.readFileSync(file, "utf8");
  for (const m of text.matchAll(/\b(?:app|apiRouter|router)\s*\.\s*(get|post|put|delete)\s*\(\s*(["'`])([^"'`]+)\2/g)) {
    console.log(m[1].toUpperCase(), m[3]);
  }
}
JS
)

"$engine" run --rm -i --entrypoint node "$IMAGE" -e "$scan" | node "$ROOT/tools/routes.mts" "$ROOT/default-allow.txt" "$IMAGE" "$@"
